{
  "name": "opds-feed",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted OPDS 1.2 catalog that turns article URLs into EPUBs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^11.7.0",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.6.14",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
