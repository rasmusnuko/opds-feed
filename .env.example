# ---------------------------------------------------------------- required

# Credentials your e-reader and browser use (HTTP Basic).
OPDS_USERNAME=reader

# Preferred: a scrypt hash from `npm run hash-password`.
OPDS_PASSWORD_HASH=

# Or, if you would rather not hash it, a plaintext password (ignored when a hash is set).
#OPDS_PASSWORD=

# The externally visible base URL. Used to build the links inside the OPDS feed,
# so it must match what the reader connects to, with no trailing slash.
PUBLIC_URL=https://books.example.com

# ---------------------------------------------------------------- ingest

# Comma-separated bearer tokens for POST /api/articles (phone shortcuts, bookmarklets).
# Generate one with: openssl rand -base64 24
API_TOKENS=

# ---------------------------------------------------------------- server

HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
CATALOG_TITLE=Articles
CATALOG_AUTHOR=opds-feed
LOG_LEVEL=info

# Honour X-Forwarded-Proto / X-Forwarded-Host from your reverse proxy.
TRUST_PROXY=true

# ---------------------------------------------------------------- catalogue

# Entries per OPDS page. Small readers cope badly with very long feeds.
FEED_PAGE_SIZE=25
# How far back the "Latest" shelf reaches.
FEED_RECENT_DAYS=14

# ---------------------------------------------------------------- conversion

# Reader-compatibility knobs. The defaults suit small greyscale e-ink screens.
# greyscale | colour
EPUB_IMAGE_MODE=greyscale
EPUB_EMBED_IMAGES=true
EPUB_MAX_IMAGE_WIDTH=800
EPUB_MAX_IMAGES=40
EPUB_JPEG_QUALITY=72
EPUB_COVER_WIDTH=600
EPUB_COVER_HEIGHT=800
EPUB_LANGUAGE=en

# ---------------------------------------------------------------- fetching

FETCH_TIMEOUT_MS=30000
FETCH_MAX_BYTES=10485760
# Leave false unless you deliberately want to ingest from your own LAN.
# Turning this on removes the SSRF protection on the ingest API.
FETCH_ALLOW_PRIVATE_ADDRESSES=false

# ---------------------------------------------------------------- extraction

# Where per-site extraction rules are read from, earlier directories first.
# Default: $DATA_DIR/site-rules, then the site-rules/ directory shipped with the app.
# See site-rules/README.md.
#SITE_RULES_DIRS=./data/site-rules,./site-rules

# Largest request (URL plus page HTML) a bookmarklet or shortcut may send.
SUBMIT_MAX_BYTES=10485760

# ---------------------------------------------------------------- queue & feeds

QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=30000

RSS_ENABLED=true
RSS_POLL_INTERVAL_MINUTES=30
RSS_MAX_ITEMS_PER_POLL=10
