# ---------------------------------------------------------------- required

# Credentials your e-reader and browser use (HTTP Basic).
OPDS_USERNAME=reader

# Preferred: a scrypt hash from `npm run hash-password`.
OPDS_PASSWORD_HASH=

# Or, if you would rather not hash it, a plaintext password (ignored when a hash is set).
#OPDS_PASSWORD=

# The externally visible base URL. Used to build the links inside the OPDS feed,
# so it must match what the reader connects to, with no trailing slash.
PUBLIC_URL=https://books.example.com

# ---------------------------------------------------------------- ingest

# Comma-separated bearer tokens for POST /api/articles (phone shortcuts, bookmarklets).
# Generate one with: openssl rand -base64 24
API_TOKENS=

# ---------------------------------------------------------------- server

HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
CATALOG_TITLE=Articles
CATALOG_AUTHOR=opds-feed
LOG_LEVEL=info

# Honour X-Forwarded-Proto / X-Forwarded-Host from your reverse proxy.
TRUST_PROXY=true

# ---------------------------------------------------------------- catalogue

# Entries per OPDS page. Small readers cope badly with very long feeds.
FEED_PAGE_SIZE=25
# How far back the "Latest" shelf reaches.
FEED_RECENT_DAYS=14

# ---------------------------------------------------------------- conversion

# Reader-compatibility knobs. The defaults suit small greyscale e-ink screens.
# greyscale | colour
EPUB_IMAGE_MODE=greyscale
EPUB_EMBED_IMAGES=true
EPUB_MAX_IMAGE_WIDTH=800
EPUB_MAX_IMAGES=40
EPUB_JPEG_QUALITY=72
EPUB_COVER_WIDTH=600
EPUB_COVER_HEIGHT=800
EPUB_LANGUAGE=en

# ---------------------------------------------------------------- fetching

FETCH_TIMEOUT_MS=30000
FETCH_MAX_BYTES=10485760
# Leave false unless you deliberately want to ingest from your own LAN.
# Turning this on removes the SSRF protection on the ingest API.
FETCH_ALLOW_PRIVATE_ADDRESSES=false

# ---------------------------------------------------------------- queue & feeds

QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=30000

RSS_ENABLED=true
RSS_POLL_INTERVAL_MINUTES=30
RSS_MAX_ITEMS_PER_POLL=25

# ---------------------------------------------------------------- prospects

# Feed items become prospects: title, teaser and link only. Nothing is fetched or
# converted until you press Save.

# Undecided prospects are dropped after this many days, counted from when you first
# saw them (not from the article's publication date).
PROSPECT_EXPIRY_DAYS=14
PROSPECT_PAGE_SIZE=50
PROSPECT_UNDO_WINDOW_HOURS=24

# ---------------------------------------------------------------- summaries

# The Summary button fetches an article, summarises it, and keeps only the summary
# (~300 bytes against ~200 KB for a converted EPUB).
SUMMARY_ENABLED=false

# Any OpenAI-compatible chat-completions endpoint.
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://127.0.0.1:11434/v1
#   llama.cpp:   http://127.0.0.1:8080/v1
SUMMARY_ENDPOINT=https://openrouter.ai/api/v1

# Required for a hosted endpoint; local endpoints usually need nothing.
SUMMARY_API_KEY=

SUMMARY_MODEL=google/gemini-2.0-flash-001

# Truncating the article is the main cost and latency lever, and costs little quality:
# the opening of a piece is nearly always enough to judge whether it is worth reading.
SUMMARY_MAX_INPUT_CHARS=6000
SUMMARY_MAX_OUTPUT_TOKENS=200
SUMMARY_TEMPERATURE=0.3
SUMMARY_TIMEOUT_MS=60000
